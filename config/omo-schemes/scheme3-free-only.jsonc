// Scheme 3: 纯免费(opencode)分层模型路由
//
// 目标：成本 = 0，所有调用都在 opencode 提供商内完成
// 模型选择遵循"按角色能力匹配"：
//   · 核心执行 / 高推理  → nemotron-3-ultra-free（推理最强，SWE-Bench 70.7）
//   · 长输出 / 创作      → nemotron-3.5-lightning-free（262k output）
//   · 高频轻量          → ling-3.0-flash-fin-free（支持 low/medium/high variant）
//   · 多模态            → mimo-v2.5-free（image/video/audio）
//
// 4 层降级（全部在 opencode 内）：
//   ① 主模型（同角色能力分组内的免费旗舰）
//        ↓
//   ② 同分组内的其他免费模型
//        ↓
//   ③ 跨分组的免费模型（按能力互补）
//        ↓
//   ④ big-pickle（主动探索，幻觉偏多，仅作最末位兜底）
//
// 约束：
//   · 不引用 coding-plan / zhipuai / deepseek（付费/限时免费）
//   · 不引用 muse-spark-contributor 系列（国内不可访问）
//   · nemotron / mimo / big-pickle 均无 variants，不可配置
//   · 仅 ling-3.0-flash-fin-free 支持 variant: low / medium / high
//   · 模型失效时 Agent 直接崩溃（无付费兜底），需密切关注 opencode models 变更
{
  "[opencode]": {
    "agents": {
      "sisyphus": {
        "model": "opencode/nemotron-3-ultra-free",
        "fallback_models": [
          {
            "model": "opencode/nemotron-3.5-lightning-free"
          },
          {
            "model": "opencode/mimo-v2.5-free"
          },
          {
            "model": "opencode/ling-3.0-flash-fin-free",
            "variant": "high"
          },
          {
            "model": "opencode/big-pickle"
          }
        ]
      },
      "hephaestus": {
        "model": "opencode/nemotron-3-ultra-free",
        "fallback_models": [
          {
            "model": "opencode/nemotron-3.5-lightning-free"
          },
