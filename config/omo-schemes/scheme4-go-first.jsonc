// Scheme 4: Opencode Go 套餐优先 —— 主链全走 opencode-go 订阅，免费模型末位兜底
//
// 定位：已订阅 Opencode Go（$20/月，3 设备）。26 个模型全家桶（deepseek/glm/kimi/
//       qwen/minimax/mimo/grok/gpt/muse-spark/longcat/hy），订阅内调用不另收按量费。
//
// 主模型分配：
//   核心执行  sisyphus    → opencode-go/glm-5.3                （通用旗舰，套餐内）
//             hephaestus  → opencode-go/kimi-k2.7-code         （代码特化，262k output）
//   高推理    oracle / momus / ultrabrain
//             → opencode-go/muse-spark-1.3-contributor(xhigh)  （套餐版国内可达）
//             metis / deep → muse-spark-1.3 / kimi-k3
//   高频轻量  librarian / explore / quick / unspecified-low / sisyphus-junior
//             → opencode-go/glm-5.3-flash / qwen3.8-flash
//   规划创作  prometheus / atlas / unspecified-high
//             → opencode-go/kimi-k3(max) / gpt-5.6-luna
//             artistry / writing → grok-4.6（500k output，创意/长文）
//   多模态    multimodal-looker / visual-engineering
//             → opencode-go/mimo-v2.5-pro / deepseek-v4-flash-vision-exp
//
// fallback 链：opencode-go 套餐内跨厂切换 → opencode 免费模型末位兜底（额度耗尽不中断）
//             全程不引用 coding-plan / zhipuai / deepseek 按量 provider，零按量费用
//
// 模型约束（以 `opencode models` 实际目录为准，2026-09-20）：
//   · muse-spark-contributor 套餐版(opencode-go/)国内可访问；免费版(opencode/)仍不可达
//   · 套餐内支持 variant：muse-spark(minimal~xhigh)、gpt-5.6-luna(none~max)、
//     grok-4.6(low~xhigh)、glm-5.3/5.3-flash(low/high/max)、deepseek-v4-flash|v4.1-flash
//     |vision(low/high/max)、kimi-k3(仅 max)、qwen3.8-flash(low/medium/xhigh)、
//     minimax-m3(none/thinking)
//   · kimi-k2.7-code、mimo-v2.5-pro、qwen3.x-plus/max 无 variant，不可配置
//   · deepseek-v4-pro 已下线（2026-09-14），不引用
{
  "[opencode]": {
    "agents": {
      "sisyphus": {
        "model": "opencode-go/glm-5.3",
        "fallback_models": [
          { "model": "opencode-go/gpt-5.6-luna", "variant": "high" },
          { "model": "opencode/big-pickle" }
        ]
      },
      "hephaestus": {
        "model": "opencode-go/kimi-k2.7-code",
        "fallback_models": [
          { "model": "opencode-go/glm-5.3", "variant": "high" },
          { "model": "opencode-go/deepseek-v4.1-flash", "variant": "high" },
          { "model": "opencode/big-pickle" }
        ]
      },
      "oracle": {
        "model": "opencode-go/muse-spark-1.3-contributor",
        "fallback_models": [
          { "model": "opencode-go/gpt-5.6-luna", "variant": "max" },
          { "model": "opencode-go/grok-4.6", "variant": "xhigh" },
          { "model": "opencode/nemotron-3-ultra-free" }
        ],
        "variant": "xhigh"
      },
      "librarian": {
        "model": "opencode-go/glm-5.3-flash",
        "fallback_models": [
          { "model": "opencode-go/qwen3.8-flash", "variant": "medium" },
          { "model": "opencode/ling-3.0-flash-fin-free", "variant": "high" }
        ]
      },
      "explore": {
        "model": "opencode-go/glm-5.3-flash",
        "fallback_models": [
          { "model": "opencode-go/deepseek-v4-flash", "variant": "high" },
          { "model": "opencode-go/longcat-2.0", "variant": "medium" },
          { "model": "opencode/ling-3.0-flash-fin-free", "variant": "high" }
        ]
      },
      "multimodal-looker": {
        "model": "opencode-go/mimo-v2.5-pro",
        "fallback_models": [
          { "model": "opencode-go/deepseek-v4-flash-vision-exp", "variant": "high" },
          { "model": "opencode-go/muse-spark-1.3-contributor", "variant": "low" },
          { "model": "opencode/mimo-v2.5-free" }
        ]
      },
      "prometheus": {
        "model": "opencode-go/kimi-k3",
        "fallback_models": [
          { "model": "opencode-go/grok-4.6", "variant": "high" },
          { "model": "opencode-go/glm-5.3", "variant": "max" },
          { "model": "opencode/nemotron-3-ultra-free" }
        ],
        "variant": "max"
      },
      "metis": {
        "model": "opencode-go/muse-spark-1.3-contributor",
        "fallback_models": [
          { "model": "opencode-go/gpt-5.6-luna", "variant": "high" },
          { "model": "opencode-go/glm-5.3", "variant": "max" },
          { "model": "opencode/big-pickle" }
        ],
        "variant": "xhigh"
      },
      "momus": {
        "model": "opencode-go/muse-spark-1.3-contributor",
        "fallback_models": [
          { "model": "opencode-go/grok-4.6", "variant": "xhigh" },
          { "model": "opencode-go/gpt-5.6-luna", "variant": "max" },
          { "model": "opencode/nemotron-3-ultra-free" }
        ],
        "variant": "xhigh"
      },
      "atlas": {
        "model": "opencode-go/kimi-k3",
        "fallback_models": [
          { "model": "opencode-go/gpt-5.6-luna", "variant": "high" },
          { "model": "opencode-go/glm-5.3", "variant": "max" },
          { "model": "opencode/big-pickle" }
        ],
        "variant": "max"
      },
      "sisyphus-junior": {
        "model": "opencode-go/glm-5.3-flash",
        "fallback_models": [
          { "model": "opencode-go/qwen3.8-flash", "variant": "medium" },
          { "model": "opencode-go/deepseek-v4-flash", "variant": "high" },
          { "model": "opencode/nemotron-3.5-lightning-free" }
        ]
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "opencode-go/mimo-v2.5-pro",
        "fallback_models": [
          { "model": "opencode-go/muse-spark-1.3-contributor", "variant": "high" },
          { "model": "opencode-go/deepseek-v4-flash-vision-exp", "variant": "max" },
          { "model": "opencode/mimo-v2.5-free" }
        ]
      },
      "ultrabrain": {
        "model": "opencode-go/muse-spark-1.3-contributor",
        "fallback_models": [
          { "model": "opencode-go/gpt-5.6-luna", "variant": "max" },
          { "model": "opencode-go/grok-4.6", "variant": "xhigh" },
          { "model": "opencode/nemotron-3-ultra-free" }
        ],
        "variant": "xhigh"
      },
      "deep": {
        "model": "opencode-go/muse-spark-1.3-contributor",
        "fallback_models": [
          { "model": "opencode-go/kimi-k3", "variant": "max" },
          { "model": "opencode-go/glm-5.3", "variant": "max" },
          { "model": "opencode/big-pickle" }
        ],
        "variant": "xhigh"
      },
      "artistry": {
        "model": "opencode-go/grok-4.6",
        "fallback_models": [
          { "model": "opencode-go/minimax-m3", "variant": "thinking" },
          { "model": "opencode-go/mimo-v2.5-pro" },
          { "model": "opencode/big-pickle" }
        ],
        "variant": "high"
      },
      "quick": {
        "model": "opencode-go/glm-5.3-flash",
        "fallback_models": [
          { "model": "opencode-go/qwen3.8-flash", "variant": "medium" },
          { "model": "opencode/ling-3.0-flash-fin-free", "variant": "high" }
        ]
      },
      "unspecified-low": {
        "model": "opencode-go/glm-5.3-flash",
        "fallback_models": [
          { "model": "opencode-go/qwen3.8-flash", "variant": "medium" },
          { "model": "opencode-go/deepseek-v4-flash", "variant": "high" },
          { "model": "opencode/ling-3.0-flash-fin-free", "variant": "high" }
        ],
        "variant": "high"
      },
      "unspecified-high": {
        "model": "opencode-go/kimi-k3",
        "fallback_models": [
          { "model": "opencode-go/gpt-5.6-luna", "variant": "xhigh" },
          { "model": "opencode-go/muse-spark-1.3-contributor", "variant": "high" },
          { "model": "opencode/nemotron-3-ultra-free" }
        ],
        "variant": "max"
      },
      "writing": {
        "model": "opencode-go/grok-4.6",
        "fallback_models": [
          { "model": "opencode-go/minimax-m3", "variant": "thinking" },
          { "model": "opencode-go/kimi-k3", "variant": "max" },
          { "model": "opencode/nemotron-3.5-lightning-free" }
        ],
