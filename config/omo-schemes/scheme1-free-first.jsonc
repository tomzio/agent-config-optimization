// Scheme 1: 免费(opencode) → coding-plan 套餐 → zhipuai GLM 按量 → deepseek 按量（绝对末位）
// 参考 Commit a0fa618
// 适用场景：套餐额度紧张/想最大化利用免费模型、或免费模型在当前网络环境表现更好
//
// 模型分层：
//   ① opencode 免费（主力） → ② coding-plan 套餐 → ③ zhipuai GLM 按量 → ④ deepseek 按量（末位）
{
  "[opencode]": {
    "agents": {
      "sisyphus": {
        "model": "opencode/nemotron-3-ultra-free",
        "fallback_models": [
          { "model": "coding-plan/ark-code-latest" },
          { "model": "opencode/muse-spark-1.3-contributor-free", "variant": "high" },
          { "model": "zhipuai/glm-5.2" },
        ],
      },
      "hephaestus": {
        "model": "opencode/nemotron-3.5-lightning-free",
        "fallback_models": [
          { "model": "coding-plan/kimi-k2.7-code" },
          { "model": "opencode/muse-spark-1.3-contributor-free", "variant": "high" },
          { "model": "zhipuai/glm-5.2" },
        ],
      },
      "oracle": {
        "model": "opencode/nemotron-3-ultra-free",
        "fallback_models": [
          { "model": "coding-plan/deepseek-v4-pro" },
          { "model": "opencode/muse-spark-1.3-contributor-free", "variant": "xhigh" },
          { "model": "zhipuai/glm-5.3" },
          { "model": "deepseek/deepseek-v4-pro", "variant": "max" },
        ],
      },
      "librarian": {
        "model": "opencode/ling-3.0-flash-fin-free",
